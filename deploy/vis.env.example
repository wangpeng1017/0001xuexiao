# vis-platform 配置文件示例
# install.sh 会自动在 /etc/vis-platform/vis.env 生成随机密钥与密码，通常不需要手工复制本文件。
# 如手工维护，请确保权限为 600，修改后 systemctl restart vis-platform。

# 服务监听端口；80 需要 CAP_NET_BIND_SERVICE（systemd 单元已配置）
PORT=80

# 数据目录（SQLite 与 uploads/files）
DATA_DIR="/data/vis-platform"

# Prisma SQLite 连接串，必须与 DATA_DIR 下的 app.db 对应
DATABASE_URL="file:/data/vis-platform/app.db"

# 必填：JWT 签名密钥，建议 openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret

# 初始管理员密码；仅在首次 seed 且 admin 不存在时使用
ADMIN_INIT_PASSWORD=replace-with-a-random-password

# 前端构建产物目录
WEB_DIST="/opt/vis-platform/app/web/dist"

# 离线 GDAL / py3dtiles 环境
GDAL_BIN_DIR="/opt/vis-platform/runtime/geo/bin"
PY3DTILES_CMD="/opt/vis-platform/runtime/geo/bin/py3dtiles"

# ffmpeg 静态二进制
FFMPEG_PATH="/opt/vis-platform/runtime/ffmpeg/bin/ffmpeg"

NODE_ENV=production
APP_VERSION=0.0.0
PYTHONDONTWRITEBYTECODE=1
