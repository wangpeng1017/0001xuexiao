generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  nickname      String
  passwordHash  String
  role          String
  disabled      Boolean   @default(false)
  mustChangePwd Boolean   @default(false)
  failCount     Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects        Project[] @relation("ProjectOwner")
  updatedProjects Project[] @relation("ProjectUpdatedBy")
  ledTeams        Team[]         @relation("TeamLeader")
  teamMemberships TeamMember[]
  materials       Material[]     @relation("MaterialOwner")

  @@index([role])
}

model Project {
  id          String    @id @default(cuid())
  projectName String
  remarks     String?
  indexImage  String?
  state       Int       @default(-1)
  sortOrder   Int
  content     String    @default("{}")
  version     Int       @default(0)
  ownerId     String
  teamId      String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  isTemplate       Boolean   @default(false)
  templateCategory String?

  owner     User  @relation("ProjectOwner", fields: [ownerId], references: [id])
  updatedBy User? @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])
  team      Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([sortOrder])
  @@index([deletedAt])
  @@index([teamId])
  @@index([isTemplate])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  leaderId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leader   User         @relation("TeamLeader", fields: [leaderId], references: [id])
  members  TeamMember[]
  projects Project[]

  @@index([leaderId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Material {
  id        String   @id @default(cuid())
  category  String
  name      String
  url       String
  thumb     String   @default("")
  scope     String   @default("private")
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("MaterialOwner", fields: [ownerId], references: [id])

  @@index([category])
  @@index([ownerId])
  @@index([scope])
}
