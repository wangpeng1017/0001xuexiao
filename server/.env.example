# 服务端口
PORT=3001
NODE_ENV=development

# 数据目录（数据库与上传文件都放在这里）
DATA_DIR=./data

# SQLite 连接串；相对路径以 prisma/schema.prisma 所在目录为基准
DATABASE_URL="file:../data/app.db"

# 必填：JWT 签名密钥，生产环境请使用足够长的随机字符串
JWT_SECRET=change-me-to-a-long-random-string

# 初始管理员密码；留空则首次 seed 时随机生成并打印
ADMIN_INIT_PASSWORD=

# 生产环境前端 dist 目录；留空则不托管前端
WEB_DIST=
